# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# ---- LLM (Groq, free tier) ----
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Enables POST /auth/demo-login/{role} (no password, for demos only).
# Set to false before any real/public deployment.
DEMO_MODE=true

# ---- Database ----
# Default: local SQLite file, zero setup required.
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db

# If you've implemented PgVectorStore and are running docker-compose's
# Postgres+pgvector service instead, switch to:
# DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_db

# ---- Vector backend ----
# "numpy" (default, zero setup) or "pgvector" (requires Postgres + pgvector ext)
VECTOR_BACKEND=numpy

# ---- Storage ----
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads

# ---- Ingestion ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=10

# ---- Models (downloaded automatically on first run, free/local) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
